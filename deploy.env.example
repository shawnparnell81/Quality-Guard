# Copy this file to `.env` in the repo root, then `docker compose up -d`.
# `.env` is git-ignored - your secrets stay out of the repo.

# ---- required ----
# The Postgres password. Make it long; nothing else needs to know it.
POSTGRES_PASSWORD=change-me-to-something-long-and-random

# ---- TLS ----
# A domain whose A/AAAA record points at this server gets an automatic
# Let's Encrypt certificate. Leave it as "localhost" to run locally
# with Caddy's self-signed cert (the browser warns once).
DOMAIN=localhost
# Let's Encrypt sends certificate-expiry notices here. Required for a
# real domain.
TLS_EMAIL=

# ---- optional: email notifications ----
# With SMTP_HOST empty, email is off and the daily digest does not run
# (see server/.env.example for the full description).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=QMS Guardian <no-reply@localhost>
DIGEST_HOUR=7

# ---- logging ----
# debug | info | warn | error
LOG_LEVEL=info
