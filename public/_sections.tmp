###drawings###
    <section class="view" id="view-drawings" hidden>
        <div class="view-head">
            <h1 class="view-title">Engineering Drawings<span class="clause-ref">8.3</span></h1>
            <p class="view-sub">Design output under control. Production works to the released revision and sees nothing else.</p>
        </div>
        <div class="grid-2">
            <div class="panel">
                <div class="panel-head"><h2 class="panel-title">Drawing register</h2></div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Drawing</th><th>Title</th><th>Rev</th><th>Customer</th><th>Open ECN</th><th>Access</th></tr></thead>
                        <tbody id="drawing-table"></tbody>
                    </table>
                </div>
            </div>
            <div class="stack">
                <div class="panel">
                    <div class="panel-head"><h2 class="panel-title" id="drawing-number">Select a drawing</h2></div>
                    <div class="panel-body" id="drawing-detail"></div>
                </div>
                <div class="panel">
                    <div class="panel-head"><h2 class="panel-title">Revision history</h2><span class="panel-note">clause 7.5.3</span></div>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Rev</th><th>Change</th><th>ECN</th><th>Released</th><th>Status</th></tr></thead>
                            <tbody id="revision-table"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
###receiving###
    <section class="view" id="view-receiving" hidden>
        <div class="view-head">
            <h1 class="view-title">Receiving Inspection<span class="clause-ref">8.4.2</span></h1>
            <p class="view-sub">Verification that purchased product meets requirements before it reaches the floor. The sampling plan follows the grade of the vendor.</p>
        </div>
        <div class="grid-2">
            <div class="panel">
                <div class="panel-head"><h2 class="panel-title">Receipts</h2><span class="panel-note">pending first</span></div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Receipt</th><th>PO</th><th>Vendor</th><th>Part</th><th class="num">Qty</th><th>Plan</th><th>Status</th></tr></thead>
                        <tbody id="receipt-table"></tbody>
                    </table>
                </div>
            </div>
            <div class="stack">
                <div class="panel">
                    <div class="panel-head"><h2 class="panel-title" id="receipt-number">Select a receipt</h2></div>
                    <div class="panel-body" id="receipt-detail"></div>
                </div>
                <div class="panel">
                    <div class="panel-head"><h2 class="panel-title">Measurements</h2></div>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Characteristic</th><th>Spec</th><th>Actual</th><th>Gage</th><th>Result</th></tr></thead>
                            <tbody id="measurement-table"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
###shipping###
    <section class="view" id="view-shipping" hidden>
        <div class="view-head">
            <h1 class="view-title">Shipping<span class="clause-ref">8.6</span></h1>
            <p class="view-sub">Release of product. Nothing ships until every planned verification is complete and an authorised person signs.</p>
        </div>
        <div class="grid-2">
            <div class="panel">
                <div class="panel-head"><h2 class="panel-title">Shipments</h2><span class="panel-note">blocked first</span></div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Shipment</th><th>Customer</th><th>Part</th><th>Lot</th><th class="num">Qty</th><th>Checks</th><th>Status</th></tr></thead>
                        <tbody id="shipment-table"></tbody>
                    </table>
                </div>
            </div>
            <div class="stack">
                <div class="panel">
                    <div class="panel-head">
                        <h2 class="panel-title" id="shipment-number">Select a shipment</h2>
                        <span class="panel-note" id="shipment-note"></span>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Verification</th><th>Evidence</th><th>Status</th><th></th></tr></thead>
                            <tbody id="check-table"></tbody>
                        </table>
                    </div>
                </div>
                <div class="panel">
                    <div class="panel-head"><h2 class="panel-title">Shipment detail</h2></div>
                    <div class="panel-body" id="shipment-detail"></div>
                </div>
            </div>
        </div>
    </section>
###onboarding###
    <section class="view" id="view-onboarding" hidden>
        <div class="view-head">
            <h1 class="view-title">Vendor Onboarding<span class="clause-ref">8.4.1</span></h1>
            <p class="view-sub">Evaluation and selection of external providers. Stages run in order, and the last one is the only route onto the approved vendor list.</p>
        </div>
        <div class="grid-2">
            <div class="panel">
                <div class="panel-head"><h2 class="panel-title">Candidates</h2></div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Vendor</th><th>Scope</th><th>Progress</th><th>Status</th></tr></thead>
                        <tbody id="candidate-table"></tbody>
                    </table>
                </div>
            </div>
            <div>
                <div class="panel" style="margin-bottom:16px">
                    <div class="panel-head"><h2 class="panel-title" id="candidate-name">Select a candidate</h2><span class="panel-note">six stages</span></div>
                </div>
                <div class="pipe" id="onboarding-pipe"></div>
            </div>
        </div>
    </section>
###review###
    <section class="view" id="view-review" hidden>
        <div class="view-head">
            <h1 class="view-title">Management Review<span class="clause-ref">9.3</span></h1>
            <p class="view-sub">The standard names twelve required inputs. Every one is assembled from the module that holds it, so the pack cannot go stale.</p>
        </div>
        <div class="panel" style="margin-bottom:16px">
            <div class="panel-head"><h2 class="panel-title">Reviews</h2><span class="panel-note">quarterly</span></div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Reference</th><th>Period</th><th>Held</th><th>Chair</th><th>Status</th></tr></thead>
                    <tbody id="review-table"></tbody>
                </table>
            </div>
        </div>
        <div class="grid-2">
            <div class="panel">
                <div class="panel-head"><h2 class="panel-title" id="review-reference">Select a review</h2><span class="panel-note">clause 9.3.2 inputs</span></div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Clause</th><th>Required input</th><th>From</th><th>Now</th></tr></thead>
                        <tbody id="review-inputs"></tbody>
                    </table>
                </div>
            </div>
            <div class="panel">
                <div class="panel-head"><h2 class="panel-title">Decisions and actions</h2><span class="panel-note">clause 9.3.3</span></div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Decision</th><th>Owner</th><th>Due</th><th>Status</th></tr></thead>
                        <tbody id="review-actions"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
###scorecards###
    <section class="view" id="view-scorecards" hidden>
        <div class="view-head">
            <h1 class="view-title">Scorecards and KPIs<span class="clause-ref">6.2 / 9.1.3</span></h1>
            <p class="view-sub">Quality objectives with a target, an owner, and an actual. Figures marked live are recalculated from the records every time this page loads.</p>
        </div>
        <div class="panel">
            <div class="panel-head">
                <h2 class="panel-title">Quality objectives</h2>
                <span class="panel-note" id="objective-note"></span>
            </div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Objective</th><th>Clause</th><th class="num">Target</th><th class="num">Actual</th><th>Unit</th><th>Owner</th><th>State</th></tr></thead>
                    <tbody id="objective-table"></tbody>
                </table>
            </div>
        </div>
    </section>
