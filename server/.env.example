# Copy this file to .env and fill in your own values.
# The .env file holds your database password, so never commit it.

PGHOST=localhost
PGPORT=5432
PGDATABASE=qualityguard
PGUSER=postgres
PGPASSWORD=change_me

PORT=3001

# The server serves the front end itself (see server/src/app.js), so
# there is nothing to configure for CORS. Open the app at this
# server's own URL, e.g. http://localhost:3001 — the session cookie
# will not authenticate a front end opened from a different origin.

# Leave unset for local development. Set to "production" on a real
# deployment: it turns on the Secure flag on the session cookie
# (auth.js) and stops error responses from including the underlying
# message (app.js) - a database error string can leak schema detail.
NODE_ENV=

# Structured logs go to stdout, one JSON object per line. This gates
# which levels are emitted: debug | info | warn | error. Default info.
LOG_LEVEL=

# Where uploaded files (not controlled documents) are stored:
#   local - disk under server/storage (default; dev and single box)
#   s3    - object store; survives redeploys, works multi-instance.
#           Contract only in this build - see server/src/file-storage.js.
STORAGE_DRIVER=

# Email notifications (P3.5). All optional: with SMTP_HOST unset,
# every send is a logged no-op and the daily digest does not run, so
# the "Email me" preference simply has no effect. Set these to turn
# it on.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=QMS Guardian <no-reply@localhost>
# Local hour (0-23) the daily digest is sent. Default 7.
DIGEST_HOUR=7
