# Copy this file to .env and fill in your own values.
# The .env file holds your database password, so never commit it.

PGHOST=localhost
PGPORT=5432
PGDATABASE=qualityguard
PGUSER=postgres
PGPASSWORD=change_me

PORT=3001

# Where the front end is served from, for CORS.
# Use http://localhost:5500 if you open index.html with the VS Code
# Live Server extension.
CLIENT_ORIGIN=http://localhost:5500
