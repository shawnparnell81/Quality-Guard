{
  "key": "final_release_checklist",
  "name": "Final Inspection & Product Release Checklist (Automotive OEM)",
  "prefix": "FRC",
  "clause": "8.6",
  "category": "Inspection",
  "standard": "IATF 16949",
  "description": "Objective evidence that finished automotive OEM product conforms to the approved drawing, specifications, control plan, PPAP status, customer-specific requirements, and packaging / shipping standards before release - document control, part / order / lot identification, the release-prerequisite / product-verification / packaging-verification checklists (Pass / Fail / N/A per item), key characteristic results, nonconformance & containment, and the final release authorization with sign-off.",
  "fields": [
    { "key": "form_number", "label": "Form No.", "type": "text", "section": "Document control" },
    { "key": "revision", "label": "Revision", "type": "text", "section": "Document control" },
    { "key": "effective_date", "label": "Effective Date", "type": "date", "section": "Document control" },
    { "key": "plant_site", "label": "Plant / Site", "type": "text", "section": "Document control" },
    { "key": "department", "label": "Department", "type": "text", "section": "Document control" },

    { "key": "customer_oem", "label": "Customer / OEM", "type": "text", "required": true, "section": "Part, order & lot identification" },
    { "key": "customer_part_number", "label": "Customer Part No.", "type": "text", "required": true, "section": "Part, order & lot identification" },
    { "key": "part_description", "label": "Part Description", "type": "text", "required": true, "section": "Part, order & lot identification" },
    { "key": "internal_part_number", "label": "Internal Part No.", "type": "text", "section": "Part, order & lot identification" },
    { "key": "drawing_revision", "label": "Drawing Revision", "type": "text", "required": true, "section": "Part, order & lot identification" },
    { "key": "purchase_order", "label": "Purchase Order", "type": "text", "section": "Part, order & lot identification" },
    { "key": "work_order", "label": "Work Order", "type": "text", "required": true, "section": "Part, order & lot identification" },
    { "key": "lot_batch_heat_number", "label": "Lot / Batch / Heat No.", "type": "text", "required": true, "section": "Part, order & lot identification" },
    { "key": "quantity_produced", "label": "Quantity Produced", "type": "number", "section": "Part, order & lot identification" },
    { "key": "quantity_inspected", "label": "Quantity Inspected", "type": "number", "section": "Part, order & lot identification" },
    { "key": "sampling_plan_level", "label": "Sampling Plan / Level", "type": "text", "section": "Part, order & lot identification" },
    { "key": "production_date_shift", "label": "Production Date / Shift", "type": "text", "section": "Part, order & lot identification" },
    { "key": "line_machine_tool", "label": "Line / Machine / Tool", "type": "text", "section": "Part, order & lot identification" },
    { "key": "inspector", "label": "Inspector", "type": "text", "required": true, "section": "Part, order & lot identification" },
    { "key": "inspection_datetime", "label": "Inspection Date / Time", "type": "date", "required": true, "section": "Part, order & lot identification" },

    { "key": "rp_1_1", "label": "1.1 - Approved drawing and specification at the required revision are available.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "1. Release prerequisites" },
    { "key": "rp_1_2", "label": "1.2 - Approved PPAP / interim approval is valid for this part, process, site, tooling, and material.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "1. Release prerequisites" },
    { "key": "rp_1_3", "label": "1.3 - Current control plan, work instructions, inspection standard, and visual aids are available.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "1. Release prerequisites" },
    { "key": "rp_1_4", "label": "1.4 - All engineering changes, deviations, concessions, and temporary approvals are current and within scope.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "1. Release prerequisites" },
    { "key": "rp_1_5", "label": "1.5 - All required in-process inspections, SPC records, and operator sign-offs are complete and acceptable.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "1. Release prerequisites" },
    { "key": "rp_1_6", "label": "1.6 - Required first-off / first article and last-off / last article approvals are complete.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "1. Release prerequisites" },
    { "key": "rp_1_7", "label": "1.7 - Required material, plating, coating, heat-treatment, laboratory, or certificate-of-analysis records are present and accepted.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "1. Release prerequisites" },
    { "key": "rp_1_8", "label": "1.8 - All inspection and test equipment used is identified, within calibration, suitable for tolerance, and in acceptable condition.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "1. Release prerequisites" },
    { "key": "rp_1_9", "label": "1.9 - Applicable customer-specific requirements and special release instructions have been reviewed.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "1. Release prerequisites" },
    { "key": "release_evidence_remarks", "label": "Evidence / remarks (cite item no.)", "type": "memo", "section": "1. Release prerequisites" },

    { "key": "pv_2_1", "label": "2.1 - Part identity, geometry, and configuration match the part number and approved design record.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "2. Product verification" },
    { "key": "pv_2_2", "label": "2.2 - All safety, regulatory, critical, significant, and other special characteristics identified on the drawing and control plan were verified at the specified frequency.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "2. Product verification" },
    { "key": "pv_2_3", "label": "2.3 - Dimensional results meet specification; actual readings and measurement record reference are documented below.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "2. Product verification" },
    { "key": "pv_2_4", "label": "2.4 - Material, hardness, performance, functional, leak, torque, electrical, or other required test results meet acceptance criteria.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "2. Product verification" },
    { "key": "pv_2_5", "label": "2.5 - Surface finish, coating, plating, color, gloss, texture, and cleanliness meet requirements where applicable.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "2. Product verification" },
    { "key": "pv_2_6", "label": "2.6 - Visual condition is acceptable: no cracks, burrs, sharp edges, contamination, corrosion, dents, scratches, flash, distortion, or other prohibited defects.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "2. Product verification" },
    { "key": "pv_2_7", "label": "2.7 - Assembly is complete; required components, fasteners, seals, clips, inserts, and orientation are correct.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "2. Product verification" },
    { "key": "pv_2_8", "label": "2.8 - Identification and traceability markings are present, legible, durable, correct, and linked to the production lot.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "2. Product verification" },
    { "key": "pv_2_9", "label": "2.9 - Error-proofing verification and required challenge / master sample checks are complete and acceptable.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "2. Product verification" },
    { "key": "pv_2_10", "label": "2.10 - No mixed parts, suspect material, rework, unauthorized repair, or nonconforming product is present in the release quantity.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "2. Product verification" },
    { "key": "product_evidence_remarks", "label": "Evidence / remarks (cite item no.)", "type": "memo", "section": "2. Product verification" },
    {
      "key": "characteristic_results", "label": "Key / Special Characteristic Results", "type": "table",
      "section": "2. Product verification",
      "columns": [
        { "key": "characteristic", "label": "Characteristic / Symbol", "type": "text" },
        { "key": "specification_tolerance", "label": "Specification & Tolerance", "type": "text" },
        { "key": "actual_results", "label": "Actual Result(s)", "type": "text" },
        { "key": "gage_id", "label": "Gage ID", "type": "text" },
        { "key": "status", "label": "Status", "type": "select", "options": ["Pass", "Fail"] }
      ]
    },

    { "key": "pk_3_1", "label": "3.1 - Approved customer packaging specification and latest pack instruction are available and followed.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "3. Packaging, labeling & shipping verification" },
    { "key": "pk_3_2", "label": "3.2 - Container, dunnage, protection, corrosion prevention, cleanliness, closure, and pallet condition are acceptable.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "3. Packaging, labeling & shipping verification" },
    { "key": "pk_3_3", "label": "3.3 - Standard pack quantity, total quantity, container count, and unit of measure are correct.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "3. Packaging, labeling & shipping verification" },
    { "key": "pk_3_4", "label": "3.4 - Customer label format, part number, revision, quantity, lot/date code, supplier code, serial data, and barcode content are correct and scannable.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "3. Packaging, labeling & shipping verification" },
    { "key": "pk_3_5", "label": "3.5 - Required hazardous-material, regulatory, country-of-origin, special-handling, and returnable-container markings are correct.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "3. Packaging, labeling & shipping verification" },
    { "key": "pk_3_6", "label": "3.6 - Packing slip, advance shipping notice data, certificates, and other required shipment documents agree with the product and purchase order.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "3. Packaging, labeling & shipping verification" },
    { "key": "pk_3_7", "label": "3.7 - Shipment is protected from damage, contamination, deterioration, and mixed-lot / mixed-part risk during storage and transport.", "type": "select", "options": ["Pass", "Fail", "N/A"], "section": "3. Packaging, labeling & shipping verification" },
    { "key": "packaging_evidence_remarks", "label": "Evidence / remarks (cite item no.)", "type": "memo", "section": "3. Packaging, labeling & shipping verification" },

    { "key": "any_requirement_failed", "label": "Any Requirement Failed?", "type": "select", "options": ["No", "Yes"], "section": "4. Nonconformance & containment" },
    { "key": "affected_quantity", "label": "Affected Quantity", "type": "number", "section": "4. Nonconformance & containment" },
    { "key": "hold_quarantine_location", "label": "Hold / Quarantine Location", "type": "text", "section": "4. Nonconformance & containment" },
    { "key": "ncr_deviation_concession_number", "label": "NCR / Deviation / Concession No.", "type": "text", "section": "4. Nonconformance & containment" },
    { "key": "containment_segregated", "label": "Containment: segregated", "type": "boolean", "section": "4. Nonconformance & containment" },
    { "key": "containment_sorted", "label": "Containment: 100% sorted", "type": "boolean", "section": "4. Nonconformance & containment" },
    { "key": "containment_reinspected", "label": "Containment: reinspected", "type": "boolean", "section": "4. Nonconformance & containment" },
    { "key": "containment_customer_notified", "label": "Containment: customer notified", "type": "boolean", "section": "4. Nonconformance & containment" },
    { "key": "containment_other", "label": "Other containment", "type": "text", "section": "4. Nonconformance & containment" },
    {
      "key": "disposition", "label": "Disposition", "type": "select",
      "options": ["Rework", "Scrap", "Return", "Use-As-Is by Written Approval"],
      "section": "4. Nonconformance & containment"
    },
    { "key": "disposition_other", "label": "Other disposition", "type": "text", "section": "4. Nonconformance & containment" },
    { "key": "nonconformance_evidence", "label": "Description / Evidence", "type": "memo", "section": "4. Nonconformance & containment" },

    {
      "key": "final_decision", "label": "Final Decision", "type": "select",
      "options": ["RELEASE", "HOLD", "REJECT", "CONDITIONAL RELEASE - Written Authorization Attached"],
      "section": "5. Final release authorization"
    },
    { "key": "quantity_released", "label": "Quantity Released", "type": "number", "section": "5. Final release authorization" },
    { "key": "final_inspector_name", "label": "Final Inspector - Name", "type": "text", "section": "5. Final release authorization" },
    { "key": "final_inspector_signature", "label": "Final Inspector - Signature / Initials", "type": "signature", "section": "5. Final release authorization" },
    { "key": "final_inspector_datetime", "label": "Final Inspector - Date / Time", "type": "date", "section": "5. Final release authorization" },
    { "key": "quality_approver_name", "label": "Quality Approval - Name", "type": "text", "section": "5. Final release authorization" },
    { "key": "quality_signature", "label": "Quality Approval - Signature", "type": "signature", "section": "5. Final release authorization" },
    { "key": "quality_approval_datetime", "label": "Quality Approval - Date / Time", "type": "date", "section": "5. Final release authorization" },
    { "key": "additional_approver_name", "label": "Additional Approval - Name / Function", "type": "text", "section": "5. Final release authorization" },
    { "key": "additional_signature", "label": "Additional Approval - Signature", "type": "signature", "section": "5. Final release authorization" },
    { "key": "additional_approval_datetime", "label": "Additional Approval - Date / Time", "type": "date", "section": "5. Final release authorization" }
  ]
}
