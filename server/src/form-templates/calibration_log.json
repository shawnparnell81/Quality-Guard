{
  "key": "calibration_log",
  "name": "Master Calibration Log",
  "prefix": "CALLOG",
  "clause": "7.1.5",
  "category": "Measurement",
  "standard": "ISO 9001 / IATF 16949",
  "description": "Your master calibration log - one line per gage or instrument with its interval, last and next due dates, and calibration status. Download the Excel template, fill the equipment rows, and \"Fill from Excel\" reads them straight back onto a record. (The built-in Calibration / Gages module tracks each gage as its own record; this is the flat controlled-spreadsheet log.)",
  "fields": [
    {
      "key": "equipment", "label": "Equipment", "type": "table", "required": true,
      "columns": [
        { "key": "equipment_id", "label": "Equipment ID", "type": "text" },
        { "key": "item_description", "label": "Item Description", "type": "text" },
        { "key": "manufacturer", "label": "Manufacturer", "type": "text" },
        { "key": "model", "label": "Model", "type": "text" },
        { "key": "serial_number", "label": "Serial Number (S/N)", "type": "text" },
        { "key": "location", "label": "Location", "type": "text" },
        { "key": "last_cal_date", "label": "Last Cal Date", "type": "date" },
        { "key": "interval_months", "label": "Interval (Months)", "type": "number" },
        { "key": "next_cal_due_date", "label": "Next Cal Due Date", "type": "date" },
        { "key": "days_until_due", "label": "Days Until Due", "type": "number" },
        { "key": "calibration_status", "label": "Calibration Status", "type": "text" },
        { "key": "calibrated_by", "label": "Calibrated By", "type": "text" },
        { "key": "cert_report_number", "label": "Cert / Report #", "type": "text" },
        {
          "key": "record_status", "label": "Status (Active/Inactive)", "type": "select",
          "options": ["Active", "Inactive"]
        }
      ]
    }
  ]
}
