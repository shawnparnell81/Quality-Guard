    { "key": "initial_samples_notes", "label": "3. Initial production samples (dimensional / visual / laboratory / performance)", "type": "memo", "section": "APQP elements" },
    { "key": "gage_msa_notes", "label": "4. Gage and test equipment - MSA (special characteristics)", "type": "memo", "section": "APQP elements" },
    { "key": "process_monitoring_notes", "label": "5. Process monitoring (instructions / process sheets / visual aids)", "type": "memo", "section": "APQP elements" },
    { "key": "packaging_shipping_notes", "label": "6. Packaging / shipping (packaging approval / shipping trials)", "type": "memo", "section": "APQP elements" },
    { "key": "signoff_1", "label": "Sign-off - team member / title / date (1)", "type": "text", "section": "Sign-off" },
    { "key": "signoff_2", "label": "Sign-off - team member / title / date (2)", "type": "text", "section": "Sign-off" },
    { "key": "signoff_3", "label": "Sign-off - team member / title / date (3)", "type": "text", "section": "Sign-off" }
  ]
