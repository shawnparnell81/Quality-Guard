    { "key": "customer", "label": "Customer", "type": "text", "section": "Header" },
    { "key": "manufacturing_plant", "label": "Manufacturing Plant", "type": "text", "section": "Header" },
    { "key": "capability_study_notes", "label": "1. Preliminary process capability study (Ppk - special characteristics)", "type": "memo", "section": "APQP elements" },
