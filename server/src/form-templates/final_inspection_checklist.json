{
  "key": "final_inspection_checklist",
  "name": "Final Product Inspection & Release Checklist",
  "prefix": "FIC",
  "clause": "8.6",
  "category": "Inspection",
  "standard": "ISO 9001 / IATF 16949",
  "description": "Pre-shipment lot gate - the lot / part identification, a live checked / rejected / acceptance-yield panel, the parameter specification log with a passed / rejected status per line against its LSL / USL, and the release-authority sign-off with the final logistic disposition gate.",
  "fields": [
    { "key": "lot_batch_id", "label": "Product Lot / Batch ID", "type": "text", "required": true, "section": "Lot identification" },
    { "key": "inspection_datetime", "label": "Inspection Date / Time", "type": "date", "section": "Lot identification" },
    { "key": "part_asset_id", "label": "Part Number / Asset ID", "type": "text", "section": "Lot identification" },
    { "key": "certified_quality_inspector", "label": "Certified Quality Inspector", "type": "text", "section": "Lot identification" },

    { "key": "count_checked", "label": "Total Checked", "type": "number", "section": "Lot performance summary" },
    { "key": "count_rejected", "label": "Rejected", "type": "number", "section": "Lot performance summary" },
    { "key": "lot_yield_pct", "label": "Lot Acceptance Yield %", "type": "number", "section": "Lot performance summary" },

    {
      "key": "parameters", "label": "Product Parameter Specification Log", "type": "table", "required": true,
      "section": "Product parameter specification log",
      "columns": [
        { "key": "characteristic", "label": "Inspection Parameter / Characteristic", "type": "text" },
        { "key": "lsl", "label": "LSL", "type": "number" },
        { "key": "usl", "label": "USL", "type": "number" },
        { "key": "actual_value", "label": "Actual Measured Value", "type": "number" },
        { "key": "measurement_method", "label": "Measurement Method / Device", "type": "text" },
        { "key": "status", "label": "Status", "type": "text" }
      ]
    },

    { "key": "inspecting_technician", "label": "Inspecting Technician", "type": "signature", "section": "Release authorization" },
    { "key": "quality_manager_release_authority", "label": "Quality Manager / Release Authority", "type": "signature", "section": "Release authorization" },
    {
      "key": "final_disposition_gate", "label": "Final Logistic Disposition Gate", "type": "select",
      "options": ["Lot released for shipment", "Lot quarantined on hold"],
      "section": "Release authorization"
    }
  ]
}
