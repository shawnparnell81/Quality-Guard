{
  "key": "work_order_form",
  "name": "Production Work Order",
  "prefix": "WOF",
  "clause": "8.5.1",
  "category": "Production",
  "standard": "ISO 9001 / IATF 16949",
  "description": "The shop-floor work order from your own template - order and traceability header, raw-material verification, the process routing with its control-plan and inspection references, and a yield / scrap sign-off. Download the Excel template, fill it in, and \"Fill from Excel\" reads it straight back onto a record.",
  "fields": [
    { "key": "work_order_number", "label": "Work Order #", "type": "text", "required": true, "section": "1.0 Order & Traceability Information" },
    { "key": "date_issued", "label": "Date Issued", "type": "date", "section": "1.0 Order & Traceability Information" },
    { "key": "part_number", "label": "Part Number", "type": "text", "required": true, "section": "1.0 Order & Traceability Information" },
    { "key": "revision", "label": "Rev", "type": "text", "section": "1.0 Order & Traceability Information" },
    { "key": "customer", "label": "Customer", "type": "text", "section": "1.0 Order & Traceability Information" },
    { "key": "target_date", "label": "Target Date", "type": "date", "section": "1.0 Order & Traceability Information" },
    { "key": "part_description", "label": "Part Description", "type": "text", "section": "1.0 Order & Traceability Information" },
    { "key": "drawing_ref", "label": "Drawing Ref", "type": "text", "section": "1.0 Order & Traceability Information" },
    { "key": "order_qty", "label": "Order Qty", "type": "text", "section": "1.0 Order & Traceability Information" },
    { "key": "priority_level", "label": "Priority Level", "type": "text", "section": "1.0 Order & Traceability Information" },
    { "key": "lot_batch_number", "label": "Lot / Batch #", "type": "text", "section": "1.0 Order & Traceability Information" },
    { "key": "special_class", "label": "Special Class", "type": "text", "section": "1.0 Order & Traceability Information" },

    {
      "key": "materials", "label": "Raw Material & Components", "type": "table",
      "section": "2.0 Raw Material & Components Verification",
      "columns": [
        { "key": "item_mat_id", "label": "Item / Mat ID", "type": "text" },
        { "key": "description", "label": "Description", "type": "text" },
        { "key": "required_qty", "label": "Required Qty", "type": "text" },
        { "key": "allocated_lot", "label": "Allocated Lot #", "type": "text" },
        { "key": "heat_mill_cert", "label": "Heat / Mill Cert", "type": "text" },
        { "key": "inspected_by", "label": "Inspected By", "type": "text" },
        { "key": "release_date", "label": "Release Date", "type": "date" },
        { "key": "status", "label": "Status", "type": "text" }
      ]
    },

    {
      "key": "routing", "label": "Process Routing", "type": "table",
      "section": "3.0 Process Routing & Quality Control Methods",
      "columns": [
        { "key": "op_number", "label": "Op #", "type": "text" },
        { "key": "operation_desc", "label": "Operation Desc", "type": "text" },
        { "key": "work_center", "label": "Work Center", "type": "text" },
        { "key": "special_class_symbol", "label": "Special Class Symbol", "type": "text" },
        { "key": "control_plan_ref", "label": "Control Plan Ref", "type": "text" },
        { "key": "inspection_method", "label": "Inspection Method", "type": "text" },
        { "key": "operator_sign", "label": "Operator Sign", "type": "text" },
        { "key": "qa_sign", "label": "QA Sign", "type": "text" }
      ]
    },

    { "key": "good_parts_yielded", "label": "Total Good Parts Yielded", "type": "number", "section": "4.0 Quality Validation & Sign-Off" },
    { "key": "defective_scrap_parts", "label": "Total Defective / Scrap Parts", "type": "number", "section": "4.0 Quality Validation & Sign-Off" }
